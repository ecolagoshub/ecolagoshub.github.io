rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // config/access holds the secret code; clients can never read it.
    match /config/{d} { allow read, write: if false; }

    // A user becomes a member only by supplying the correct access code.
    match /members/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email','code'])
        && request.resource.data.code == get(/databases/$(db)/documents/config/access).data.code;
    }

    // Each member can only touch their own tasks.
    match /users/{uid}/tasks/{id} {
      allow read, write: if request.auth != null && request.auth.uid == uid
        && exists(/databases/$(db)/documents/members/$(uid));
    }
  }
}
